{
  "name": "moneycogs-video-factory",
  "version": "1.0.0",
  "private": true,
  "description": "Data-driven YouTube video factory for MoneyCogs — daily whiteboard explainers of business & money mechanisms.",
  "type": "module",
  "scripts": {
    "build:video": "tsx pipeline/build.ts",
    "audio": "python3 pipeline/generate_audio.py",
    "manifest": "tsx pipeline/build_manifest.ts",
    "captions": "tsx pipeline/build_captions.ts",
    "package": "tsx pipeline/package.ts",
    "studio": "remotion studio remotion/src/index.ts",
    "render": "remotion render remotion/src/index.ts Main",
    "calendar:fill": "tsx pipeline/fill_calendar.ts",
    "topics:next": "tsx pipeline/topics.ts next",
    "topics:pick": "tsx pipeline/topics.ts pick",
    "topics:done": "tsx pipeline/topics.ts done",
    "topics:skip": "tsx pipeline/topics.ts skip",
    "topics:add": "tsx pipeline/topics.ts add",
    "topics:list": "tsx pipeline/topics.ts list",
    "topics:stats": "tsx pipeline/topics.ts stats",
    "day": "tsx pipeline/run_day.ts",
    "fetch": "tsx pipeline/fetch_release.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.534",
    "@remotion/paths": "^4.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
