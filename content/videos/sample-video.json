  "scenes": [
    {
      "id": "intro",
      "type": "section_title",
      "narration": "Every time you swipe a credit card, a tiny money machine springs to life. Here is exactly how it turns your spending into profit.",
      "visual": {
        "number": 1,
        "title": "The Card Machine",
        "emphasis": "underline",
        "sync": { "phrase": "money machine" }
      }
    },
    {
      "id": "swipe",
      "type": "character_scene",
      "narration": "You buy a coffee and tap your card. In a blink, your four dollars starts a race between three companies you never see.",
      "visual": {
        "title": "Tap to pay",
        "stage": "street",
        "elements": [
          {
            "kind": "figure",
            "id": "you",
            "cast": "penny",
            "at": { "col": 1, "row": 1, "w": 3, "h": 5 },
            "pose": "standing",
            "expression": "curious",
            "holding": { "prop": "coffee", "hand": "right" },
            "label": "you",
            "effects": [{ "kind": "thought_bubble", "sync": { "phrase": "never see" } }]
          },
          {
            "kind": "coins",
            "at": { "col": 8, "row": 1, "w": 3, "h": 4 },
            "color": "accent",
            "label": "four dollars",
            "sync": { "phrase": "four dollars" }
          }
        ]
      }
    },
    {
      "id": "split",
      "type": "stat_chart",
      "narration": "Picture your four dollars split four ways. The shop keeps the most, but the bank and the card network each take a slice, and the processor grabs a few cents too.",
      "visual": {
        "label": "Where your money goes (cents)",
        "mode": "bars",
        "datapoints": [
          { "label": "Shop", "value": 388, "sync": { "phrase": "shop keeps" } },
          { "label": "Bank", "value": 8, "sync": { "phrase": "bank" } },
          { "label": "Network", "value": 3, "sync": { "phrase": "card network" } },
          { "label": "Processor", "value": 1, "sync": { "phrase": "processor grabs" } }
        ]
      }
    },
    {
      "id": "interchange",
      "type": "character_scene",
      "narration": "That slice the bank takes is called the interchange fee. It is roughly two percent of everything you spend, quietly skimmed off every single swipe.",
      "visual": {
        "title": "The bank's cut",
        "stage": "desk-office",
        "elements": [
          {
            "kind": "figure",
            "id": "bank",
            "cast": "ledger",
            "at": { "col": 6, "row": 1, "w": 4, "h": 5 },
            "facing": "left",
            "pose": "presenting",
            "expression": "happy",
            "holding": { "prop": "moneybag", "hand": "left" },
            "label": "the bank",
            "effects": [{ "kind": "money", "sync": { "phrase": "every single swipe" } }]
          },
          {
            "kind": "percent",
            "at": { "col": 1, "row": 1, "w": 2, "h": 3 },
            "color": "accent",
            "label": "two percent",
            "sync": { "phrase": "two percent" }
          }
        ]
      }
    },
    {
      "id": "taps",
      "type": "list_card",
      "narration": "So a card makes money in three ways. It charges merchants a fee. It charges you interest when you carry a balance. And it charges late fees when you slip.",
      "visual": {
        "title": "Three money taps",
        "items": [
          { "label": "Merchant swipe fees", "icon": "tick", "sync": { "phrase": "charges merchants a fee" } },
          { "label": "Interest on balances", "icon": "box", "sync": { "phrase": "carry a balance" } },
          { "label": "Late fees", "icon": "arrow", "sync": { "phrase": "late fees" } }
        ]
      }
    },
    {
      "id": "apr",
      "type": "stat_chart",
      "narration": "Interest is the real engine. The average card charges about twenty two percent a year on money you borrow.",
      "visual": {
        "label": "Typical card interest",
        "mode": "number",
        "suffix": "%",
        "datapoints": [{ "label": "APR", "value": 22, "sync": { "phrase": "twenty two percent" } }]
      }
    },
    {
      "id": "trap",
      "type": "character_scene",
      "narration": "Here is the trap. If you only pay the minimum, that twenty two percent compounds, and a small balance can quietly double over a few years.",
      "visual": {
        "title": "The minimum trap",
        "stage": "room",
        "elements": [
          {
            "kind": "figure",
            "id": "payer",
            "cast": "penny",
