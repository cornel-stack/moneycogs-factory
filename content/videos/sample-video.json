            "label": "minimum payer",
            "effects": [{ "kind": "sweat_drop", "sync": { "phrase": "the trap" } }]
          },
          {
            "kind": "snowball",
            "at": { "col": 8, "row": 1, "w": 3, "h": 4 },
            "label": "it compounds",
            "sync": { "phrase": "compounds" }
          }
        ]
      }
    },
    {
      "id": "growth",
      "type": "stat_chart",
      "narration": "Watch a two thousand dollar balance at that rate. Year one it is near two thousand four forty. Year two, almost three thousand. Year three, over three thousand six hundred.",
      "visual": {
        "label": "A 2000 dollar balance grows ($)",
        "mode": "line",
        "datapoints": [
          { "label": "Now", "value": 2000, "sync": { "phrase": "two thousand dollar" } },
          { "label": "Yr 1", "value": 2440, "sync": { "phrase": "two thousand four forty" } },
          { "label": "Yr 2", "value": 2980, "sync": { "phrase": "almost three thousand" } },
          { "label": "Yr 3", "value": 3640, "sync": { "phrase": "three thousand six hundred" } }
        ]
      }
    },
    {
      "id": "beat",
      "type": "character_scene",
      "narration": "You beat the machine in one move. Pay the full balance every month, and all those fees and interest simply never touch you.",
      "visual": {
        "title": "Beat the machine",
